---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getPublishedPosts, groupByTag, type Post } from "../../../lib/posts";

export async function getStaticPaths() {
	const groups = groupByTag(await getPublishedPosts());
	return groups.map(({ slug, tag, posts }) => ({ params: { tag: slug }, props: { tag, posts } }));
}

interface Props {
	tag: string;
	posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout pageTitle={`${tag} — Writing — Netkuki`} description={`Notes on ${tag} from rauland: things built, lessons learned, and ideas still taking shape.`}>
	<main class="inner-page">
		<p class="eyebrow"><span class="status-dot"></span> THE NOTEBOOK · TAG</p>
		<h1 class="inner-title">Writing on<br /><span>{tag}.</span></h1>
		<p class="inner-lede">{posts.length} {posts.length === 1 ? "note" : "notes"} tagged {tag}.</p>
		<div class="article-list">
			{posts.map((post) => <ArticleCard post={post} />)}
		</div>
		<a class="back-link" href="/writing/">← All writing</a>
	</main>
</BaseLayout>
