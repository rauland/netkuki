---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Home";
import { Content as MarkdownContent } from "../content/home.md";
import { FeatureBlock } from "@/components/IndexCards";

const netkuki = [
	{
		title: "netkuki",
		imgsrc: "/assets/logo-symbol.png",
		content: ["Netkuki is a personal blog and portfolio website built with Astro, Tailwind CSS, and Shadcn UI, and hosted on Cloudflare Pages."],
	},
	{
		imgsrc:"/assets/astro.png",
		title: "Astro",
		content:["Astro is a JavaScript web framework optimized for building fast, content-driven websites."]
	},
	{
		imgsrc:"/assets/tailwindcss.jpg",
		title: "TailwindCSS",
		content:["Tailwind CSS is an open-source CSS framework."]
	},
	{
		imgsrc:"/assets/shadcn.png",
		title: "Shadcn UI",
		content:["Shadcn UI is a UI component library."]
	},
	{
		imgsrc:"/assets/cloudflare.png",
		title: "Cloudflare pages",
		content:["Cloudflare Pages is a modern web application hosting platform."]
	},
]
---

<html lang="en">
	<head>
		<title>{pageTitle}</title>
	</head>
	<body>
		<BaseLayout pageTitle={pageTitle}>
			<div class="pr-4 pl-4">
				<h2 class="mb-5">Welcome to netkuki.com</h2>
				<FeatureBlock data={netkuki} />
				<!-- <h4>Netkuki is built and deployed with the following:</h4> -->
				<!-- <FeatureBlock data={dependencies} /> -->
				<MarkdownContent />
			</div>
		</BaseLayout>
	</body>
</html>
