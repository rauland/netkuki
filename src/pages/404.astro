---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Page not found — Netkuki" description="This page drifted off into space." noindex>
	<main class="inner-page">
		<p class="eyebrow"><span class="status-dot"></span> 404 · LOST IN SPACE</p>
		<h1 class="inner-title">Nothing here<br /><span>but crumbs.</span></h1>
		<p class="inner-lede">The page you were looking for has drifted out of orbit, or it never existed. The cookie is still where you left it.</p>
		<div class="hero-actions">
			<a class="button button-primary" href="/">Back to the cookie <span aria-hidden="true">↗</span></a>
			<a class="text-link" href="/writing/">Read my writing <span aria-hidden="true">↗</span></a>
		</div>
	</main>
</BaseLayout>
