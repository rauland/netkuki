---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";

const { pageTitle = "Netkuki" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f6f2" />
		<meta name="description" content="Netkuki is a personal corner of the internet for things made, things learned, and ideas worth sharing." />
		<link rel="icon" type="image/png" href="/assets/logo-symbol.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<Header />
		<div class="site-content"><slot /></div>
		<Footer />
	</body>
</html>
